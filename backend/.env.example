# Local single-file database. Good for quick backend development without Docker.
DATABASE_URL=sqlite:///./oneopen_loom.db

# PostgreSQL option. Use this when running against Docker Compose or a local Postgres server.
# DATABASE_URL=postgresql+psycopg://oneopen:oneopen@localhost:5432/oneopen_loom

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOADS_DIR=./uploads
